{
  "name": "karofi-sales-forecast-app",
  "version": "3.0.0",
  "description": "Hệ thống WebApp Quản lý Sales Forecast Karofi (FC App)",
  "private": true,
  "scripts": {
    "dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "build:client": "cd client && npm run build",
    "lint": "cd client && npm run lint",
    "gas:login": "clasp login",
    "gas:push": "node tools/gas-deploy.mjs --push",
    "gas:deploy": "node tools/gas-deploy.mjs",
    "gas:deployments": "cd gas && clasp deployments",
    "gas:open": "cd gas && clasp open",
    "gas:logs": "cd gas && clasp logs --watch",
    "seed:products": "node tools/seed-products.mjs"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1"
  }
}
